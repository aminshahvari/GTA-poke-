# Blindrise staging. Written by ops/bootstrap.sh (__DOMAIN__ is replaced with STAGING_DOMAIN).
# Caddy gets and renews the Let's Encrypt certificate by itself (ports 80 and 443 must be open and the A record must
# point here). reverse_proxy passes WebSocket upgrades (/ws) through as is, keeps the Host header (the app's /ws
# origin check compares Origin with Host) and appends the client address to X-Forwarded-For.
__DOMAIN__ {
	reverse_proxy 127.0.0.1:3000
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	log {
		output file /var/log/caddy/blindrise-access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
